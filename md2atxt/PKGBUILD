# Maintainer: Timo Früh <dev@tifrueh.ch>
pkgname=md2atxt
pkgver=0.3.1
pkgrel=0
pkgdesc="convert Markdown notes to Anki notes"
arch=(any)
url="https://github.com/tifrueh/md2atxt/"
license=('MIT')
depends=('pandoc')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
checkdepends=('python-hatch')
provides=('md2atxt')
source=("git+https://github.com/tifrueh/$pkgname.git#tag=v${pkgver//_/-}?signed")
validpgpkeys=('30AB157E6A7CA2EEBAA924F75152BE9A85F22FB5')
sha256sums=('78cf0d93726c33ec4fb53b2651563967dd3f65a0a79b11ba13f0af8a7a09d032')

build() {
	cd "$pkgname"
	python -m build --wheel --no-isolation
}

check() {
	cd "$pkgname"
	python -m hatch test
}

package() {
	cd "$pkgname"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
