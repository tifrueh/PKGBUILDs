# Maintainer: Timo Früh <dev@tifrueh.ch>
pkgname=md2atxt
pkgver=0.3.0
pkgrel=0
pkgdesc="convert Markdown notes to Anki notes"
arch=(any)
url="https://github.com/tifrueh/md2atxt/"
license=('MIT')
depends=('pandoc')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-vcs')
checkdepends=('python-hatch')
provides=('md2atxt')
source=("https://github.com/tifrueh/$pkgname/archive/refs/tags/v${pkgver//_/-}.tar.gz")
sha256sums=('4446531f7d81fd54fa53808a74828ce13d3e806a8e601ba86517e79f1a048676')

build() {
	cd "$pkgname-${pkgver//_/-}"
	export SETUPTOOLS_SCM_PRETEND_VERSION="v${pkgver//_/-}"
	python -m build --wheel --no-isolation
}

check() {
	cd "$pkgname-${pkgver//_/-}"
	python -m hatch test
}

package() {
	cd "$pkgname-${pkgver//_/-}"
	python -m installer --destdir="$pkgdir" dist/*.whl
}
